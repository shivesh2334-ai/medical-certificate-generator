# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment (Where you installed libraries locally)
venv/
env/
.env

# Vercel local configuration (if you use Vercel CLI)
.vercel

# IDE settings (VS Code, PyCharm, Mac)
.vscode/
.idea/
.DS_Store

# Generated Files & Temporary Folders
# (We don't want to commit the PDFs you generate while testing)
*.pdf
tmp/

# If you generated the stamp locally, don't push it
# (The code generates it automatically on the server)
static/stamp.png
